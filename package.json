{
  "name": "tripdistill-static",
  "private": true,
  "version": "1.0.0",
  "description": "Static TripDistill travel guides for Cloudflare Pages",
  "type": "module",
  "scripts": {
    "generate:china-expansion": "node scripts/generate-china-expansion.mjs",
    "generate:malaysia-depth": "node scripts/generate-malaysia-depth.mjs",
    "generate:vietnam": "node scripts/generate-vietnam.mjs",
    "generate:australia": "node scripts/generate-australia.mjs",
    "generate:usa": "node scripts/generate-usa.mjs",
    "generate:canada": "node scripts/generate-canada.mjs",
    "generate:switzerland": "node scripts/generate-switzerland.mjs",
    "generate:france": "node scripts/generate-france.mjs",
    "fetch:usa-images": "node scripts/fetch-usa-images.mjs",
    "fetch:canada-images": "node scripts/fetch-canada-images.mjs",
    "fetch:switzerland-images": "node scripts/fetch-switzerland-images.mjs",
    "fetch:france-images": "node scripts/fetch-france-images.mjs",
    "audit:usa": "node scripts/audit-usa.mjs",
    "audit:canada": "node scripts/audit-canada.mjs",
    "audit:switzerland": "node scripts/audit-switzerland.mjs",
    "audit:switzerland-sources": "node scripts/check-switzerland-sources.mjs",
    "audit:france": "node scripts/audit-france.mjs",
    "audit:france-sources": "node scripts/check-france-sources.mjs",
    "audit:canada-sources": "node scripts/check-canada-sources.mjs",
    "audit:nyc": "node scripts/audit-nyc-editorial.mjs",
    "audit:usa-editorial": "node scripts/audit-usa-editorial.mjs",
    "smoke:usa": "node scripts/smoke-usa.mjs",
    "smoke:canada": "node scripts/smoke-canada.mjs",
    "smoke:switzerland": "node scripts/smoke-switzerland.mjs",
    "smoke:france": "node scripts/smoke-france.mjs",
    "fetch:vietnam-images": "node scripts/fetch-vietnam-images.mjs",
    "fetch:australia-images": "node scripts/fetch-australia-images.mjs",
    "i18n:export": "node scripts/export-i18n-batch.mjs",
    "i18n:batch": "node scripts/validate-i18n-batch.mjs",
    "i18n:sample": "node scripts/sample-i18n-batch.mjs",
    "i18n:status": "node scripts/i18n-status.mjs",
    "i18n:merge": "node scripts/merge-i18n-batches.mjs",
    "i18n:prune-stale": "node scripts/prune-stale-i18n.mjs",
    "i18n:approve": "node scripts/merge-i18n-batches.mjs --approve",
    "audit:i18n": "node scripts/test-i18n-literals.mjs && node scripts/test-i18n-locale-scripts.mjs --scan-reviewed && npm run i18n:approve && node scripts/audit-translations.mjs",
    "audit:vietnam": "node scripts/audit-vietnam.mjs",
    "audit:australia": "node scripts/audit-australia.mjs",
    "audit:australia-sources": "node scripts/check-australia-sources.mjs",
    "localize:pages": "node scripts/localize-all.mjs",
    "localize": "npm run i18n:approve && npm run localize:pages",
    "sync:metadata": "node scripts/sync-language-metadata.mjs",
    "sync:sitemap": "node scripts/sync-sitemap.mjs",
    "audit": "npm run audit:i18n && npm run localize:pages && npm run audit:vietnam && npm run audit:australia && npm run audit:usa && npm run audit:canada && npm run audit:switzerland && npm run audit:france && npm run audit:nyc && npm run audit:usa-editorial && node scripts/audit-site.mjs",
    "build": "npm run localize && node scripts/build-dist.mjs",
    "preview": "node scripts/serve.mjs",
    "qa:visual": "node scripts/visual-audit.mjs",
    "pages:whoami": "npx wrangler@latest whoami",
    "pages:list": "npx wrangler@latest pages project list",
    "deploy:trip": "npm run audit && npm run build && npx wrangler@latest pages deploy dist --project-name trip"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "parse5": "^8.0.1"
  }
}
